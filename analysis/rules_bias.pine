//@version=6
// Rules Bias — encodes rules.json bias_criteria on the chart.
// Legs: 50D EMA side · daily RSI band · 4H fractal structure. Strict AND, no rounding to nearest bias.
indicator("Rules Bias", "Rules Bias", overlay = true, max_labels_count = 1)

// ── inputs ────────────────────────────────────────────────────────────────
trendTF   = input.timeframe("D",   "Trend timeframe (EMA / RSI)")
structTF  = input.timeframe("240", "Structure timeframe (pivots)")
fastLen   = input.int(50,  "Fast EMA",  minval = 1)
slowLen   = input.int(200, "Slow EMA",  minval = 1)
rsiLen    = input.int(14,  "RSI length", minval = 1)
chopPct   = input.float(2.0, "Chop band, % of fast EMA", step = 0.5)
chopBars  = input.int(20, "Chop lookback (bars)", minval = 2)
pivW      = input.int(2,  "Pivot width", minval = 1)
showTable = input.bool(true, "Show bias table")
tint      = input.bool(false, "Tint background by bias")

// ── trend-TF series (works on any chart timeframe) ────────────────────────
f_trend() =>
    e50  = ta.ema(close, fastLen)
    e200 = ta.ema(close, slowLen)
    r    = ta.rsi(close, rsiLen)
    x    = math.sum(ta.cross(close, e50) ? 1 : 0, chopBars)
    [close, e50, e200, r, x]

[tClose, tEma50, tEma200, tRsi, tCross] = request.security(syminfo.tickerid, trendTF, f_trend())

// ── structure-TF pivots: last two swing highs and lows ────────────────────
f_struct() =>
    ph = ta.pivothigh(high, pivW, pivW)
    pl = ta.pivotlow(low,  pivW, pivW)
    var float hPrev = na
    var float hLast = na
    var float lPrev = na
    var float lLast = na
    if not na(ph)
        hPrev := hLast
        hLast := ph
    if not na(pl)
        lPrev := lLast
        lLast := pl
    [hPrev, hLast, lPrev, lLast]

[hPrev, hLast, lPrev, lLast] = request.security(syminfo.tickerid, structTF, f_struct())

// ── classification ────────────────────────────────────────────────────────
rsiR    = math.round(tRsi, 1)                      // round to 1dp before comparing
distPct = (tClose - tEma50) / tEma50 * 100
above   = tClose > tEma50
below   = tClose < tEma50
chop    = math.abs(distPct) < chopPct or tCross >= 2

HH = hLast > hPrev
HL = lLast > lPrev
LH = hLast < hPrev
LL = lLast < lPrev
hhhl = HH and HL
lhll = LH and LL
structLbl = na(hPrev) or na(lPrev) ? "n/a" : hhhl ? "HH/HL" : lhll ? "LH/LL" : "mixed"

bull = above and rsiR >= 45 and rsiR <= 70 and hhhl
bear = below and rsiR <= 45 and lhll
neut = chop  and rsiR >= 40 and rsiR <= 60 and not hhhl and not lhll
hits = (bull ? 1 : 0) + (bear ? 1 : 0) + (neut ? 1 : 0)
bias = hits > 1 ? "AMBIGUOUS" : bull ? "BULLISH" : bear ? "BEARISH" : neut ? "NEUTRAL" : "NO CLEAN MATCH"

cBull = color.new(#1F8A4C, 0)
cBear = color.new(#C43C3C, 0)
cNeut = color.new(#B0741C, 0)
cNone = color.new(#6B7280, 0)
cAmb  = color.new(#7A4FB5, 0)
biasCol = bias == "BULLISH" ? cBull : bias == "BEARISH" ? cBear : bias == "NEUTRAL" ? cNeut : bias == "AMBIGUOUS" ? cAmb : cNone

// ── plots ─────────────────────────────────────────────────────────────────
plot(tEma50,  "50 EMA (trend TF)",  color = color.new(#0E7C86, 0), linewidth = 2)
plot(tEma200, "200 EMA (trend TF)", color = color.new(#B0741C, 0), linewidth = 2)
bgcolor(tint ? color.new(biasCol, 90) : na)

// ── table ─────────────────────────────────────────────────────────────────
f_mark(bool ok) => ok ? "✓" : "✕"
f_col(bool ok)  => ok ? cBull : cBear

var table t = table.new(position.top_right, 4, 7, bgcolor = color.new(color.black, 80), border_width = 1, border_color = color.new(color.gray, 70))
if showTable and barstate.islast
    table.cell(t, 0, 0, "RULES BIAS", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, bias, text_color = color.white, bgcolor = biasCol, text_size = size.small)
    table.cell(t, 2, 0, str.tostring(tClose, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(t, 3, 0, str.tostring(distPct, "+0.0;-0.0") + "% vs 50", text_color = distPct >= 0 ? cBull : cBear, text_size = size.small)

    table.cell(t, 0, 1, "", text_size = size.tiny)
    table.cell(t, 1, 1, "50 EMA",   text_color = color.gray, text_size = size.tiny)
    table.cell(t, 2, 1, "RSI",      text_color = color.gray, text_size = size.tiny)
    table.cell(t, 3, 1, "STRUCT",   text_color = color.gray, text_size = size.tiny)

    table.cell(t, 0, 2, "Bullish", text_color = color.white, text_size = size.tiny)
    table.cell(t, 1, 2, f_mark(above) + " above", text_color = f_col(above), text_size = size.tiny)
    table.cell(t, 2, 2, f_mark(rsiR >= 45 and rsiR <= 70) + " 45–70", text_color = f_col(rsiR >= 45 and rsiR <= 70), text_size = size.tiny)
    table.cell(t, 3, 2, f_mark(hhhl) + " HH/HL", text_color = f_col(hhhl), text_size = size.tiny)

    table.cell(t, 0, 3, "Bearish", text_color = color.white, text_size = size.tiny)
    table.cell(t, 1, 3, f_mark(below) + " below", text_color = f_col(below), text_size = size.tiny)
    table.cell(t, 2, 3, f_mark(rsiR <= 45) + " ≤45", text_color = f_col(rsiR <= 45), text_size = size.tiny)
    table.cell(t, 3, 3, f_mark(lhll) + " LH/LL", text_color = f_col(lhll), text_size = size.tiny)

    table.cell(t, 0, 4, "Neutral", text_color = color.white, text_size = size.tiny)
    table.cell(t, 1, 4, f_mark(chop) + " chop", text_color = f_col(chop), text_size = size.tiny)
    table.cell(t, 2, 4, f_mark(rsiR >= 40 and rsiR <= 60) + " 40–60", text_color = f_col(rsiR >= 40 and rsiR <= 60), text_size = size.tiny)
    table.cell(t, 3, 4, f_mark(not hhhl and not lhll) + " none", text_color = f_col(not hhhl and not lhll), text_size = size.tiny)

    table.cell(t, 0, 5, "Values", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 5, str.tostring(tEma50, format.mintick) + " / " + str.tostring(tEma200, format.mintick), text_color = color.white, text_size = size.tiny)
    table.cell(t, 2, 5, str.tostring(tRsi, "0.0"), text_color = color.white, text_size = size.tiny)
    table.cell(t, 3, 5, structLbl, text_color = color.white, text_size = size.tiny)

    table.cell(t, 0, 6, "Swings", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 6, "H " + str.tostring(hPrev, format.mintick) + "→" + str.tostring(hLast, format.mintick), text_color = color.white, text_size = size.tiny)
    table.cell(t, 2, 6, "L " + str.tostring(lPrev, format.mintick) + "→" + str.tostring(lLast, format.mintick), text_color = color.white, text_size = size.tiny)
    table.cell(t, 3, 6, "x" + str.tostring(tCross) + " in " + str.tostring(chopBars), text_color = color.white, text_size = size.tiny)

// ── alerts ────────────────────────────────────────────────────────────────
biasChanged = bias != bias[1]
alertcondition(biasChanged, "Rules bias changed", "Rules bias changed on {{ticker}}")
alertcondition(bull and not bull[1], "Turned BULLISH", "{{ticker}} now BULLISH per rules")
alertcondition(bear and not bear[1], "Turned BEARISH", "{{ticker}} now BEARISH per rules")
